# OS
.DS_Store
Thumbs.db

# Editors
.vscode/settings.json
.idea/

# Local Claude Code state (project-local overrides, not the shared agent system)
CLAUDE.local.md
.claude/settings.local.json

# Misc scratch
*.log
*.tmp

# cli/ (Python package) build/test artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# agent-review's own cache, in case it's ever run against this repo itself
.agent-cache/

# Local secrets -- never commit a filled-in .env; cli/.env.example is the
# tracked template (documents ANTHROPIC_FOUNDRY_RESOURCE/API_KEY/etc.)
.env
.env.*
!.env.example
